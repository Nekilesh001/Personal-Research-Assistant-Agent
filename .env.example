# ═══════════════════════════════════════════════════════
# Personal Research Assistant Agent — Environment Config
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# ─── Primary LLM: Groq (free tier, fast) ───────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Get a free key at: https://console.groq.com

# ─── Fallback LLM: OpenAI (optional) ───────────────
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ─── Local Fallback: Ollama (triggers on Groq 429) ─
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# ─── Embedding Model ────────────────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2   # default, local/free

# ─── App Configuration ──────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_DB_PATH=./data/research_agent.db
MAX_PAPERS_PER_QUERY=20
DEFAULT_PAPER_COUNT=5

# ─── CORS (front-end URL) ───────────────────────────
FRONTEND_URL=http://localhost:3000
